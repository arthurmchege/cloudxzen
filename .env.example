# Shared environment
ENVIRONMENT=development

# FastAPI API
# Native example: postgresql+psycopg://cloudxzen:YOUR_LOCAL_PASSWORD@localhost:5432/cloudxzen
# Docker-from-host example: postgresql+psycopg://cloudxzen:YOUR_LOCAL_PASSWORD@localhost:5433/cloudxzen
DATABASE_URL=
TEST_DATABASE_URL=

# Next.js web application
# Example: http://localhost:8000
API_BASE_URL=

# Docker PostgreSQL development
POSTGRES_DB=cloudxzen
POSTGRES_USER=cloudxzen
POSTGRES_PASSWORD=CHOOSE_A_LOCAL_PASSWORD
POSTGRES_HOST_PORT=5433
